[Unit]
Description=API Jirama (FastAPI)
After=network.target postgresql.service

[Service]
User=andrianina
WorkingDirectory=/home/andrianina/Bureau/Jirama_project/app/backend/app
EnvironmentFile=/home/andrianina/Bureau/Jirama_project/app/backend/.env
ExecStart=/home/andrianina/Bureau/Jirama_project/app/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/jirama/photos

[Install]
WantedBy=multi-user.target
